{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harmony HAP Installer",
  "version": "0.1.0",
  "identifier": "local.harmony.hap-installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harmony HAP Installer",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
